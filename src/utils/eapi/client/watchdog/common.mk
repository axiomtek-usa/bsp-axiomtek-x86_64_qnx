
ifndef QCONFIG
QCONFIG=qconfig.mk
endif
include $(QCONFIG)

NAME=eapi-wdtkick

HELPERS_LIB_DIR = $(QNX_TARGET)/x86_64/lib
SERVER_INC_DIR = $(QNX_TARGET)/usr/include/hw

LIBPATHS += $(HELPERS_LIB_DIR)
LIBPATHS += $(SERVER_INC_DIR)

LIBS += eapi

CCFLAGS += -I$(SERVER_INC_DIR)
CCFLAGS += -fstack-protector-strong -fPIC -D_FORTIFY_SOURCE=2
CCFLAGS += -Wtrampolines -Wall -Wformat=2 -Werror=format-extra-args -Wmissing-prototypes

# Linker flags
LDFLAGS += -Wl,-z,relro -Wl,-z,now
LDFLAGS += $(DEBUG) $(TARGET) -lsecpol


define PINFO
PINFO DESCRIPTION = Watchdog Client Driver for EAPI Server
endef

USEFILE=$(PROJECT_ROOT)/eapi-wdtkick.use

#This has to be included last

#####AUTO-GENERATED by packaging script... do not checkin#####
   INSTALL_ROOT_nto = $(PROJECT_ROOT)/../../../../../install
   USE_INSTALL_ROOT=1
##############################################################

include $(MKFILES_ROOT)/qtargets.mk
